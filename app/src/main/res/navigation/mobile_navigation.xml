<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.capstone.leukovision.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_navigation_home_to_navigation_patients"
            app:destination="@id/navigation_patients" />
        <action
            android:id="@+id/action_navigation_home_to_navigation_history"
            app:destination="@id/navigation_history" />
        <action
            android:id="@+id/action_navigation_home_to_navigation_scan"
            app:destination="@id/navigation_scan" /> <action
        android:id="@+id/action_navigation_home_to_navigation_settings"
        app:destination="@id/navigation_settings" />
        <action
            android:id="@+id/action_navigation_home_to_resultFragment"
            app:destination="@id/resultFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_patients"
        android:name="com.capstone.leukovision.ui.patients.PatientsFragment"
        android:label="@string/title_patients"
        tools:layout="@layout/fragment_patients" />

    <fragment
        android:id="@+id/navigation_scan"
        android:name="com.capstone.leukovision.ui.scan.ScanFragment"
        android:label="@string/title_scan"
        tools:layout="@layout/fragment_scan">
        <action
            android:id="@+id/action_scanFragment_to_resultFragment"
            app:destination="@id/resultFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_history"
        android:name="com.capstone.leukovision.ui.history.HistoryFragment"
        android:label="@string/title_history"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.capstone.leukovision.ui.settings.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.capstone.leukovision.ui.result.ResultFragment"
        android:label="Hasil Analisis"
        tools:layout="@layout/fragment_result">
        <argument
            android:name="detect_image"
            app:argType="android.graphics.Bitmap"
            app:nullable="true" />
        <argument
            android:name="predicted_class"
            app:argType="string"
            app:nullable="false" />
        <argument
            android:name="confidence"
            app:argType="float"
            app:nullable="false" />
    </fragment>

</navigation>